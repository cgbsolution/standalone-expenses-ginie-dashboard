# Backend base URL — the Node/Express server in ../expenses-backend
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Toggle the mock layer. When `true`, every API hook returns canned data instead
# of hitting the backend. The default is `false` now that the backend exposes
# /auth, /users, /tenants, /master-expense. Flip to `true` for offline UI work.
NEXT_PUBLIC_USE_MOCKS=false

# JWT secret for middleware signature verification (server-only). Once the
# backend issues JWTs, replace this with the real shared secret.
JWT_SECRET=replace-with-real-shared-secret

# Default tenant slug. Only used as the fallback redirect if a real session
# arrives without a tenantSlug (it shouldn't — the backend now always sets it).
NEXT_PUBLIC_DEFAULT_TENANT_SLUG=xeltrion
